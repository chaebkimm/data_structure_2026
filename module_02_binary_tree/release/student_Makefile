# GNU Make recipe for Git Bash, MSYS2, WSL, Linux, or macOS.
CC := gcc
CFLAGS ?= -std=c11 -Wall -Wextra -Wpedantic -Wconversion -Wshadow -g
CPPFLAGS ?= -Iinclude
BUILD_DIR := build

.PHONY: all starter-core starter-student-tests autopsy clean

all: starter-core

$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

starter-core: | $(BUILD_DIR)
	$(CC) $(CFLAGS) $(CPPFLAGS) starter/tree_arena.c tests/test_core.c -o $(BUILD_DIR)/starter_core
	$(BUILD_DIR)/starter_core

starter-student-tests: | $(BUILD_DIR)
	$(CC) $(CFLAGS) $(CPPFLAGS) starter/tree_arena.c tests/test_student.c -o $(BUILD_DIR)/starter_student_tests
	$(BUILD_DIR)/starter_student_tests

autopsy: | $(BUILD_DIR)
	$(CC) $(CFLAGS) $(CPPFLAGS) autopsy/faulty_links.c -o $(BUILD_DIR)/link_autopsy
	$(BUILD_DIR)/link_autopsy

clean:
	$(RM) -r $(BUILD_DIR)
