CC := gcc
CFLAGS ?= -std=c11 -Wall -Wextra -Wpedantic -g
BUILD_DIR := build
LAB_SOURCES := tests/test_lecture.c ../student/lab.c
.PHONY: all core lecture lab-compile student-tests clean
all: core
$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)
$(BUILD_DIR)/lab_core: $(LAB_SOURCES) | $(BUILD_DIR)
	$(CC) $(CFLAGS) tests/test_lecture.c -o $@
lab-compile: $(BUILD_DIR)/lab_core
lecture: lab-compile
	$(BUILD_DIR)/lab_core
core: lecture
student-tests: core
clean:
	$(RM) -r $(BUILD_DIR)
