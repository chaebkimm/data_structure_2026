# GNU Make recipe for Git Bash, MSYS2, WSL, Linux, or macOS.
CC := gcc
CFLAGS ?= -std=c11 -Wall -Wextra -Wpedantic -Wconversion -Wshadow -g
CPPFLAGS ?=
BUILD_DIR := build
LAB_SOURCE := ../student/lab.c

.PHONY: all lab-demo lab-tests autopsy clean

all: lab-demo

$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

lab-demo: | $(BUILD_DIR)
	$(CC) $(CFLAGS) $(CPPFLAGS) $(LAB_SOURCE) lab_demo.c -o $(BUILD_DIR)/lab_demo
	$(BUILD_DIR)/lab_demo

lab-tests: | $(BUILD_DIR)
	$(CC) $(CFLAGS) $(CPPFLAGS) $(LAB_SOURCE) tests/test_lab.c -o $(BUILD_DIR)/lab_tests
	$(BUILD_DIR)/lab_tests

autopsy: | $(BUILD_DIR)
	$(CC) $(CFLAGS) autopsy/faulty_top.c -o $(BUILD_DIR)/stack_top_autopsy
	$(BUILD_DIR)/stack_top_autopsy

clean:
	$(RM) -r $(BUILD_DIR)
