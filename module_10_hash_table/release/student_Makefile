# GNU Make recipe for Git Bash, MSYS2, WSL, Linux, or macOS.
CC := gcc
CFLAGS ?= -std=c11 -Wall -Wextra -Wpedantic -Wconversion -Wshadow -g
CPPFLAGS ?= -Iinclude
TEST_CPPFLAGS := $(CPPFLAGS) -DHASH_TABLE_TESTING
SANITIZER_FLAGS ?= -fsanitize=address,undefined -fno-omit-frame-pointer
BUILD_DIR := build
STARTER_SOURCES := starter/hash_table.c

.PHONY: all starter-core starter-student-tests autopsy clean

all: starter-core

$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

starter-core: | $(BUILD_DIR)
	$(CC) $(CFLAGS) $(TEST_CPPFLAGS) $(STARTER_SOURCES) tests/test_core.c -o $(BUILD_DIR)/starter_core
	$(BUILD_DIR)/starter_core

starter-student-tests: | $(BUILD_DIR)
	$(CC) $(CFLAGS) $(TEST_CPPFLAGS) $(STARTER_SOURCES) tests/test_student.c -o $(BUILD_DIR)/starter_student_tests
	$(BUILD_DIR)/starter_student_tests

autopsy: | $(BUILD_DIR)
	$(CC) $(CFLAGS) autopsy/faulty_delete_empty.c -o $(BUILD_DIR)/hash_table_autopsy
	$(BUILD_DIR)/hash_table_autopsy

clean:
	$(RM) -r $(BUILD_DIR)
